# =============================================================================
# AI-Driven Smart Welfare Resource Management System — Environment Configuration
# =============================================================================

# 1. Supabase Cloud Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key-here

# 2. Server-Side Privileged Key (Optional / Production Backend)
# WARNING: NEVER expose this key to browser code or client-side bundles.
# Used exclusively for server-side administrative maintenance or migration scripts.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# 3. Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. AI Adapter Pipeline Configuration
# Options:
#   - "demo": Uses local deterministic synthetic heuristics (Rule 7: clearly labeled).
#   - "remote": Dispatches inference requests to external Python FastAPI microservice.
NEXT_PUBLIC_AI_ADAPTER_MODE=demo

# 5. External Python Machine Learning Microservice URL (FastAPI)
# Required when NEXT_PUBLIC_AI_ADAPTER_MODE=remote
AI_SERVICE_URL=http://127.0.0.1:8000
